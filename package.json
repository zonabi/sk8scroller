{
  "name": "sk8scroller",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/sim.ts",
    "sprites": "tsx tools/sprites.ts",
    "fakie": "tsx tools/fakie-sheet.ts",
    "replay": "tsx tools/replay.ts",
    "check": "npm run typecheck && npm run test && npm run sim && npm run replay -- --verify",
    "shots": "npm run build && node tools/shot.mjs",
    "perf": "npm run build && node tools/perf.mjs"
  },
  "dependencies": {
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik-spray-paint": "^5.3.0",
    "@fontsource/sedgwick-ave-display": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
